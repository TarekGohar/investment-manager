// ─── Generator ─────────────────────────────────────────────────────────
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth ───────────────────────────────────────────────────────
// These four models are required by Better Auth. Do not rename their
// columns — Better Auth's runtime queries them by these exact names.

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String?
  image         String?
  // User-facing toggles — shape defined in lib/preferences.ts
  preferences   Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions          Session[]
  accounts          Account[]
  brokerages        Brokerage[]
  transactions      Transaction[]
  watchlist         WatchlistItem[]
  aiConversations   AIConversation[]
  alerts            Alert[]
  alertEvents       AlertEvent[]
  aiAnalyses        AIAnalysis[]
  contributionRooms ContributionRoom[]
  snapshots         PortfolioSnapshot[]
  investmentPolicy  InvestmentPolicy?
  theses            Thesis[]
  cookieSessions    ExternalCookieSession[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Domain: portfolio + transactions ──────────────────────────────────

enum DividendType {
  /// Most Canadian public-company dividends (lower combined rate).
  ELIGIBLE
  /// CCPC small-business-pool dividends (higher combined rate).
  NON_ELIGIBLE
  /// Interest, bond coupons, GIC payouts — taxed as ordinary income.
  INTEREST
  /// Dividends from foreign (US / intl) corporations. Often paid with FWT.
  FOREIGN
  /// Distribution that reduces ACB rather than being taxable income (REITs).
  RETURN_OF_CAPITAL
  /// Catch-all for unusual distributions (capital-gains distributions, etc.).
  OTHER
}

enum TransactionKind {
  BUY
  SELL
  DIVIDEND
  SPLIT
  TRANSFER_IN
  TRANSFER_OUT
  /// Cash deposited into the brokerage from an external source (paycheque,
  /// bank transfer). Used to compute cash balance per account and (in
  /// future) to drive contribution-room tracking for registered accounts.
  DEPOSIT
  /// Cash withdrawn from the brokerage to an external destination (bank,
  /// rent payment). Reduces the cash balance.
  WITHDRAWAL
}

enum BrokerageKind {
  NON_REGISTERED
  JOINT_NON_REGISTERED
  TFSA
  RRSP
  FHSA
  RESP
  LIRA
  RRIF
  CORPORATE
}

model Brokerage {
  id        String        @id @default(cuid())
  userId    String
  name      String
  // Account type — drives tax treatment. NON_REGISTERED contributes to the
  // ACB pool; TFSA/RRSP/FHSA/RESP track contribution room and have no ACB.
  kind      BrokerageKind @default(NON_REGISTERED)
  currency  String        @default("CAD")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId])
  @@map("brokerage")
}

// Per-user, per-account-type, per-year contribution room. Populated from
// the CRA Notice of Assessment / MyCRA portal. Used room is derived from
// BUY transactions in registered brokerages; remaining = roomAvailable - used.
model ContributionRoom {
  id            String        @id @default(cuid())
  userId        String
  kind          BrokerageKind // TFSA | RRSP | FHSA | RESP
  year          Int
  // The total room available this year, including carry-forward.
  roomAvailable Decimal       @db.Decimal(18, 2)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, year])
  @@index([userId])
  @@map("contribution_room")
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  brokerageId String
  /// Null for cash flows (DEPOSIT / WITHDRAWAL). Required otherwise.
  ticker      String?
  kind        TransactionKind
  /// Currency of all amount fields in this row (price, fees, etc.). Defaults
  /// from the brokerage at write time but can be overridden per transaction
  /// — e.g. a USD dividend on a US-listed stock held in a CAD-default
  /// brokerage. No FX is performed; cash balances aggregate per currency.
  currency    String          @default("CAD")
  // For BUY/SELL: shares. For DIVIDEND/DEPOSIT/WITHDRAWAL: 1 (price holds the $ amount). For SPLIT: 0.
  quantity    Decimal         @db.Decimal(18, 6)
  // For BUY/SELL: per-share. For DIVIDEND/DEPOSIT/WITHDRAWAL: total amount. For SPLIT: 0.
  price       Decimal         @db.Decimal(18, 4)
  fees        Decimal         @default(0) @db.Decimal(18, 4)
  // For DIVIDEND on foreign securities held in non-registered accounts: the
  // amount of foreign withholding tax withheld at source. Recoverable via
  // T1 foreign tax credit. Zero or null otherwise.
  foreignTaxWithheld Decimal? @db.Decimal(18, 4)
  /// Only meaningful for DIVIDEND. Drives T5 export bucketing and which
  /// marginal rate the after-tax math uses.
  dividendType DividendType?
  occurredAt  DateTime
  note        String?
  // For SPLIT only: new shares per old share (e.g. 2 for a 2-for-1).
  splitRatio  Decimal?        @db.Decimal(10, 4)
  createdAt   DateTime        @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerage Brokerage @relation(fields: [brokerageId], references: [id], onDelete: Cascade)

  @@index([userId, ticker, occurredAt])
  @@index([userId, occurredAt])
  @@map("transaction")
}

// ─── Market data cache (Phase 3) ──────────────────────────────────────
// Lazy-populated by lib/marketdata. TTLs enforced in code, not the DB.

model Quote {
  ticker    String   @id
  price     Decimal  @db.Decimal(18, 4)
  change    Decimal  @db.Decimal(18, 4)
  changePct Decimal  @db.Decimal(10, 4)
  prevClose Decimal  @db.Decimal(18, 4)
  open      Decimal? @db.Decimal(18, 4)
  high      Decimal? @db.Decimal(18, 4)
  low       Decimal? @db.Decimal(18, 4)
  asOf      DateTime
  source    String   @default("finnhub")
  fetchedAt DateTime @default(now())

  @@map("quote")
}

model NewsItem {
  id           String        @id
  ticker       String
  headline     String
  summary      String?
  url          String
  source       String
  publishedAt  DateTime
  // AI-classified materiality. Null = not yet classified.
  aiSeverity   NewsSeverity?
  classifiedAt DateTime?
  fetchedAt    DateTime      @default(now())

  @@index([ticker, publishedAt])
  @@index([ticker, aiSeverity])
  @@map("news_item")
}

model Fundamentals {
  ticker        String   @id
  companyName   String?
  industry      String?
  exchange      String?
  marketCap     Decimal? @db.Decimal(20, 2)
  peTtm         Decimal? @db.Decimal(10, 2)
  forwardPe     Decimal? @db.Decimal(10, 2)
  dividendYield Decimal? @db.Decimal(8, 6)
  beta          Decimal? @db.Decimal(8, 4)
  fiftyTwoHigh  Decimal? @db.Decimal(18, 4)
  fiftyTwoLow   Decimal? @db.Decimal(18, 4)
  logo          String?
  weburl        String?
  fetchedAt     DateTime @default(now())

  @@map("fundamentals")
}

model Candle {
  ticker String
  ts     DateTime
  open   Decimal  @db.Decimal(18, 4)
  high   Decimal  @db.Decimal(18, 4)
  low    Decimal  @db.Decimal(18, 4)
  close  Decimal  @db.Decimal(18, 4)
  volume BigInt

  @@id([ticker, ts])
  @@index([ticker, ts])
  @@map("candle")
}

// ─── Alerts ────────────────────────────────────────────────────────────

enum AlertRule {
  PRICE_MOVE
  DRAWDOWN
  CONCENTRATION
  MA_CROSS_50
  MA_CROSS_200
  VOLUME_SPIKE
  NEWS_MATERIAL
}

enum NewsSeverity {
  INFO
  MATERIAL
  CRITICAL
}

enum AlertScope {
  PORTFOLIO
  HOLDING
  TICKER
}

model Alert {
  id        String     @id @default(cuid())
  userId    String
  rule      AlertRule
  scope     AlertScope
  // When scope = TICKER, the specific ticker. Null otherwise.
  ticker    String?
  // Rule-specific parameters as JSON, e.g. { "thresholdPct": 5 }
  params    Json
  enabled   Boolean    @default(true)
  // Notification channels, e.g. ["IN_APP"] or ["IN_APP", "EMAIL"]
  channels  Json       @default("[\"IN_APP\"]")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  events AlertEvent[]

  @@index([userId, enabled])
  @@map("alert")
}

model AlertEvent {
  id      String   @id @default(cuid())
  alertId String
  userId  String
  ticker  String?
  firedAt DateTime @default(now())
  // Human-readable summary, e.g. "AAPL up 5.2% today"
  message String
  // Snapshot of values at firing
  data    Json
  read    Boolean  @default(false)

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, firedAt(sort: Desc)])
  @@index([userId, read])
  @@index([alertId, ticker, firedAt(sort: Desc)])
  @@map("alert_event")
}

// ─── Watchlist ─────────────────────────────────────────────────────────

model WatchlistItem {
  id      String   @id @default(cuid())
  userId  String
  ticker  String
  note    String?
  addedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ticker])
  @@index([userId])
  @@map("watchlist_item")
}

// ─── AI chat ───────────────────────────────────────────────────────────

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  scope     String?  // "portfolio" or a ticker symbol
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId, updatedAt])
  @@map("ai_conversation")
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  // "user" | "assistant" | "tool"
  role           String
  // Structured content: { text: string, toolCalls?: [...], toolResults?: [...] }
  // For user messages: { text }. For assistant: { text, toolCalls? }. For tool: { toolCallId, name, result }.
  content        Json
  // Token usage on assistant messages (for cost telemetry)
  inputTokens    Int?
  outputTokens   Int?
  model          String?
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_message")
}

enum AnalysisKind {
  EOD_DAILY
  WEEKLY
  ON_ALERT
  QUARTERLY_DEEP
}

enum FilingType {
  // EDGAR
  TEN_K           // 10-K   annual
  TEN_Q           // 10-Q   quarterly
  EIGHT_K         // 8-K    material event
  // SEDAR+
  ANNUAL_INFO_FORM
  MD_AND_A
  ANNUAL_FINANCIAL_STATEMENTS
  INTERIM_FINANCIAL_STATEMENTS
  MATERIAL_CHANGE_REPORT
  // Misc
  OTHER
}

enum FilingSource {
  EDGAR
  SEDAR_PLUS
  CSE
  TMX
}

/// Per-user browser session cookies for external sources that gate access
/// behind bot-management (SEDAR+ Radware + hCaptcha, etc.). The user
/// solves the captcha in their real browser, copies the cookie header,
/// and pastes it here. Server-side fetches reuse those cookies until
/// they expire.
model ExternalCookieSession {
  id           String   @id @default(cuid())
  userId       String
  /// External source identifier: "SEDAR_PLUS", "CANADIAN_INSIDER", etc.
  source       String
  /// Raw Cookie header value (e.g. "__uzma=...; __uzmb=...; ...").
  cookieHeader String   @db.Text
  /// User-Agent string from the same browser session, so the fingerprint
  /// stays consistent with the cookie batch.
  userAgent    String?
  /// Optional notes (e.g. "captured 2026-05-31 from Chrome").
  notes        String?
  /// Hint at when cookies were captured; not enforced.
  expectedExpiry DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source])
  @@index([userId])
  @@map("external_cookie_session")
}

/// Cached ticker → external-source ID mappings. Populated either by
/// auto-resolvers (EDGAR CIK lookup, TMX symbol probe) or manually by the
/// user pasting a CSE / TMX page URL.
model TickerListing {
  id          String   @id @default(cuid())
  /// Canonical ticker as used in this app — e.g. "AAPL", "SHOP.TO",
  /// "MVMD.CN". Suffix indicates listing exchange.
  ticker      String   @unique
  /// Listing exchange code. NYSE / NASDAQ / TSX / TSXV / CSE / NEO / OTHER.
  exchange    String
  name        String?
  /// SEC EDGAR Central Index Key (10-digit, zero-padded).
  cik         String?
  /// CSE issuer ID (e.g. "000023721") for webapi.thecse.com.
  cseIssuerId String?
  /// CSE URL slug (sector/company-slug) for thecse.com lookups.
  cseSlug     String?
  /// TMX symbol (usually same as ticker minus suffix).
  tmxSymbol   String?
  /// SEDAR+ issuer number (numeric, e.g. "12345") extracted from a
  /// pasted issuer profile URL. Required for cookie-authed SEDAR+ pulls.
  sedarIssuerNo String?
  /// Canonical SEDAR+ issuer-profile URL — what the user pasted, kept
  /// for reference / re-resolution.
  sedarProfileUrl String?
  resolvedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ticker_listing")
}

enum ThesisStatus {
  ACTIVE
  TRIMMED
  EXITED
  INVALIDATED
}

/// Investment policy statement. One row per user. Targets and behavioral
/// thresholds are user-supplied — nulls disable the corresponding checks.
model InvestmentPolicy {
  id                  String   @id @default(cuid())
  userId              String   @unique
  /// Target asset allocation as percentages keyed by category, e.g.
  /// { "Equity": 60, "Bonds": 30, "Cash": 10 }. Sum should be ~100.
  targetAllocation    Json     @default("{}")
  /// Target geographic split, e.g. { "Canada": 40, "US": 50, "Intl": 10 }
  targetGeography     Json     @default("{}")
  /// Drift threshold for rebalance alerts (percentage points, e.g. 5 = ±5pp).
  driftThresholdPct   Decimal? @db.Decimal(5, 2)
  /// Behavioral pattern thresholds. Null = check disabled.
  panicSellDrawdownPct Decimal? @db.Decimal(5, 2)
  panicSellWindowDays  Int?
  fomoBuyRunupPct      Decimal? @db.Decimal(5, 2)
  fomoBuyWindowDays    Int?
  overtradingPerMonth  Int?
  /// Per-ticker categorization, e.g. { "VFV.TO": "Equity:US", "VAB.TO": "Bonds:Canada" }
  tickerCategories    Json     @default("{}")
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("investment_policy")
}

/// Per-position thesis. Captures why you own this name, what would
/// invalidate the thesis, and a price target / horizon.
model Thesis {
  id                  String       @id @default(cuid())
  userId              String
  ticker              String
  body                String
  invalidationCriteria String?
  priceTargetCad      Decimal?     @db.Decimal(18, 4)
  horizonMonths       Int?
  status              ThesisStatus @default(ACTIVE)
  /// Markdown body of the most recent AI re-check ("is thesis still intact?")
  lastAiReview        String?
  lastReviewedAt      DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ticker])
  @@index([userId, status])
  @@map("thesis")
}

/// Daily portfolio NAV snapshot. Written by /api/cron/eod-snapshot. One row
/// per (userId, date). `byKind` and `holdings` are JSON blobs so we don't
/// proliferate join tables for what's effectively a frozen wire format.
model PortfolioSnapshot {
  id             String   @id @default(cuid())
  userId         String
  /// Calendar date (UTC) the snapshot represents. UNIQUE per user.
  date           DateTime @db.Date
  totalCost      Decimal  @db.Decimal(18, 2)
  totalMarketValue Decimal @db.Decimal(18, 2)
  totalRealized  Decimal  @db.Decimal(18, 2)
  totalDividends Decimal  @db.Decimal(18, 2)
  /// { NON_REGISTERED: { quantity, costBasis, marketValue }, ... }
  byKind         Json
  /// Per-ticker { ticker, quantity, costBasis, marketValue }
  holdings       Json
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date(sort: Desc)])
  @@map("portfolio_snapshot")
}

model Filing {
  id           String       @id @default(cuid())
  ticker       String
  type         FilingType
  source       FilingSource
  /// External accession number / document identifier, used for dedup.
  externalId   String
  title        String?
  /// Public link to the filing (HTML viewer).
  url          String
  filedAt      DateTime
  /// Extracted plaintext body, lazily populated by the cron / on-demand fetch.
  body         String?
  fetchedAt    DateTime     @default(now())

  @@unique([source, externalId])
  @@index([ticker, filedAt(sort: Desc)])
  @@index([ticker, type, filedAt(sort: Desc)])
  @@map("filing")
}

model AIAnalysis {
  id           String       @id @default(cuid())
  userId       String
  kind         AnalysisKind
  ticker       String?
  title        String?
  // Markdown body
  body         String
  // Snapshot of the metrics the review was written against
  metrics      Json?
  model        String?
  inputTokens  Int?
  outputTokens Int?
  generatedAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, generatedAt(sort: Desc)])
  @@index([userId, generatedAt(sort: Desc)])
  @@map("ai_analysis")
}
