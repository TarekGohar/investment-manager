// ─── Generator ─────────────────────────────────────────────────────────
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth ───────────────────────────────────────────────────────
// These four models are required by Better Auth. Do not rename their
// columns — Better Auth's runtime queries them by these exact names.

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String?
  image         String?
  // User-facing toggles — shape defined in lib/preferences.ts
  preferences   Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions          Session[]
  accounts          Account[]
  brokerages        Brokerage[]
  transactions      Transaction[]
  watchlist         WatchlistItem[]
  aiConversations   AIConversation[]
  alerts            Alert[]
  alertEvents       AlertEvent[]
  aiAnalyses        AIAnalysis[]
  contributionRooms ContributionRoom[]
  snapshots         PortfolioSnapshot[]
  investmentPolicy  InvestmentPolicy?
  theses            Thesis[]
  cookieSessions    ExternalCookieSession[]
  importBatches     ImportBatch[]
  plannedActions    PlannedAction[]
  rocAllocations    RoCAllocation[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Domain: portfolio + transactions ──────────────────────────────────

enum DividendType {
  /// Most Canadian public-company dividends (lower combined rate).
  ELIGIBLE
  /// CCPC small-business-pool dividends (higher combined rate).
  NON_ELIGIBLE
  /// Interest, bond coupons, GIC payouts — taxed as ordinary income.
  INTEREST
  /// Dividends from foreign (US / intl) corporations. Often paid with FWT.
  FOREIGN
  /// Distribution that reduces ACB rather than being taxable income (REITs).
  RETURN_OF_CAPITAL
  /// Catch-all for unusual distributions (capital-gains distributions, etc.).
  OTHER
}

enum TransactionKind {
  BUY
  SELL
  DIVIDEND
  SPLIT
  TRANSFER_IN
  TRANSFER_OUT
  /// Cash deposited into the brokerage from an external source (paycheque,
  /// bank transfer). Used to compute cash balance per account and to drive
  /// contribution-room tracking for registered accounts.
  DEPOSIT
  /// Cash withdrawn from the brokerage to an external destination (bank,
  /// rent payment). Reduces the cash balance.
  WITHDRAWAL
  /// Spinoff, merger, name change, or redenomination. Structured payload
  /// in Transaction.corporateActionPayload describes the from-side and
  /// to-side(s) with cost-basis allocation percentages.
  CORPORATE_ACTION
}

/// Why the user sold. Required on SELL rows. Feeds behavioral pattern
/// detection (panic-sells flagged unless reason is set), TLH planned-action
/// fulfilment (TLH_HARVEST sells consume the active 30-day window), and the
/// AI coach (knows when to stay quiet vs follow up).
enum SellReason {
  /// IPS drift correction. Trimming an over-weight position.
  REBALANCE_DRIFT
  /// Written invalidation criterion was met; thesis is broken.
  THESIS_INVALIDATED
  /// Realizing a loss to offset gains (or carry forward).
  TLH_HARVEST
  /// Other tax-driven decision (e.g. realize gain before bracket change).
  TAX_PLANNING
  /// Need the cash for a non-investment expense.
  CASH_NEED
  /// Anything else. Surfaces in behavioral patterns if no other reason fits.
  DISCRETIONARY
}

enum BrokerageKind {
  NON_REGISTERED
  JOINT_NON_REGISTERED
  TFSA
  RRSP
  FHSA
  RESP
  LIRA
  RRIF
  CORPORATE
}

model Brokerage {
  id        String        @id @default(cuid())
  userId    String
  name      String
  // Account type — drives tax treatment. NON_REGISTERED contributes to the
  // ACB pool; TFSA/RRSP/FHSA/RESP track contribution room and have no ACB.
  kind      BrokerageKind @default(NON_REGISTERED)
  currency  String        @default("CAD")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId])
  @@map("brokerage")
}

// Per-user, per-account-type, per-year contribution room. Populated from
// the CRA Notice of Assessment / MyCRA portal. Used room is derived from
// BUY transactions in registered brokerages; remaining = roomAvailable - used.
model ContributionRoom {
  id            String        @id @default(cuid())
  userId        String
  kind          BrokerageKind // TFSA | RRSP | FHSA | RESP
  year          Int
  // The total room available this year, including carry-forward.
  roomAvailable Decimal       @db.Decimal(18, 2)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, year])
  @@index([userId])
  @@map("contribution_room")
}

/// Year-end T3 tax breakdown for a REIT / income trust distribution.
/// Canadian trusts publish (usually in March of the following year) the
/// percentage of each year's distributions that was eligible dividend,
/// non-eligible, interest, return of capital, and capital gain. Without
/// this breakdown the importer can only flag distributions as the catch-
/// all FOREIGN/ELIGIBLE/OTHER — not the actual mix.
///
/// At year-end the user pastes the trust's breakdown here. The
/// reclassifyDividendsForYear() helper then rewrites the matching
/// DIVIDEND rows' `dividendType` and adjusts ACB for the ROC portion.
///
/// Percentages are stored as decimals 0–100; sum should be ~100.
model RoCAllocation {
  id                       String   @id @default(cuid())
  userId                   String
  ticker                   String
  year                     Int
  eligibleDividendPct      Decimal  @default(0) @db.Decimal(6, 3)
  nonEligibleDividendPct   Decimal  @default(0) @db.Decimal(6, 3)
  interestPct              Decimal  @default(0) @db.Decimal(6, 3)
  returnOfCapitalPct       Decimal  @default(0) @db.Decimal(6, 3)
  capitalGainPct           Decimal  @default(0) @db.Decimal(6, 3)
  /// Whatever T3 line items don't fit cleanly above.
  otherPct                 Decimal  @default(0) @db.Decimal(6, 3)
  notes                    String?
  /// Set when reclassifyDividendsForYear() has run for this allocation.
  /// Surfaced in the UI so the user knows the math has been applied.
  appliedAt                DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ticker, year])
  @@index([userId])
  @@map("roc_allocation")
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  brokerageId String
  /// Null for cash flows (DEPOSIT / WITHDRAWAL). Required otherwise.
  ticker      String?
  kind        TransactionKind
  /// Currency of all amount fields in this row (price, fees, etc.). Defaults
  /// from the brokerage at write time but can be overridden per transaction
  /// — e.g. a USD dividend on a US-listed stock held in a CAD-default
  /// brokerage. No FX is performed; cash balances aggregate per currency.
  currency    String          @default("CAD")
  // For BUY/SELL: shares. For DIVIDEND/DEPOSIT/WITHDRAWAL: 1 (price holds the $ amount). For SPLIT: 0.
  quantity    Decimal         @db.Decimal(18, 6)
  // For BUY/SELL: per-share. For DIVIDEND/DEPOSIT/WITHDRAWAL: total amount. For SPLIT: 0.
  price       Decimal         @db.Decimal(18, 4)
  fees        Decimal         @default(0) @db.Decimal(18, 4)
  // For DIVIDEND on foreign securities held in non-registered accounts: the
  // amount of foreign withholding tax withheld at source. Recoverable via
  // T1 foreign tax credit. Zero or null otherwise.
  foreignTaxWithheld Decimal? @db.Decimal(18, 4)
  /// Only meaningful for DIVIDEND. Drives T5 export bucketing and which
  /// marginal rate the after-tax math uses. RETURN_OF_CAPITAL reduces ACB
  /// in lib/portfolio/holdings.ts rather than being recorded as income.
  dividendType DividendType?
  /// CAD-equivalent FX rate at trade date. Populated when `currency != "CAD"`
  /// from the Bank of Canada Valet API. Required for CAD-denominated cost
  /// basis on USD/EUR/etc. holdings — without it, year-end tax reconstruction
  /// is impossible. Nullable so CAD-default rows don't carry redundant 1.0.
  fxRateToCad  Decimal?        @db.Decimal(18, 8)
  /// Required on SELL rows. Tags the sell with a reason so the behavioral
  /// detector knows when to stay quiet (a TLH_HARVEST is not a panic sell)
  /// and the coach knows when a thesis was retired.
  reasonCode   SellReason?
  /// True on BUY rows that represent a dividend reinvestment inside a
  /// registered account. Excluded from contribution-room math (DRIP'd
  /// dividends don't consume new room).
  isDrip       Boolean         @default(false)
  /// Set when this row was created by a CSV import. Lets the user roll back
  /// a botched import in one click. Null for hand-entered rows.
  importBatchId String?
  /// For GIC / bond rows: maturity date. UI shows a countdown so the user
  /// can decide whether to roll over before maturity. Doesn't affect ACB.
  maturesAt   DateTime?
  /// For CORPORATE_ACTION rows. Shape:
  ///   { event: "SPINOFF"|"MERGER"|"NAME_CHANGE"|"REDENOMINATION",
  ///     legs: [{ ticker, ratio, basisAllocationPct }], notes }
  ///  - SPINOFF: parent ticker on the Transaction.ticker; legs list new
  ///    children; basisAllocationPct must sum to ≤ 100 (remainder stays
  ///    with the parent).
  ///  - MERGER: legs list the surviving ticker(s); 100% basis flows out
  ///    of parent into the survivor pool.
  ///  - NAME_CHANGE / REDENOMINATION: 1-leg case, all qty & cost transfer.
  corporateActionPayload Json?
  occurredAt  DateTime
  note        String?
  // For SPLIT only: new shares per old share (e.g. 2 for a 2-for-1).
  splitRatio  Decimal?        @db.Decimal(10, 4)
  createdAt   DateTime        @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerage   Brokerage    @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@index([userId, ticker, occurredAt])
  @@index([userId, occurredAt])
  @@index([importBatchId])
  @@map("transaction")
}

/// One row per CSV upload. Lets us audit and roll back a botched import as
/// a unit. Rollback = delete every Transaction with this row's id.
model ImportBatch {
  id               String   @id @default(cuid())
  userId           String
  /// Brokerage these rows were assigned to at import time. Stored by id for
  /// stable rollback even if the brokerage is renamed.
  brokerageId      String
  /// "RBC_DI" for now; future brokers add their own keys.
  source           String   @default("RBC_DI")
  /// Original filename from the upload (display only).
  sourceFilename   String
  /// How many Transaction rows this batch created (post-skip).
  transactionCount Int      @default(0)
  /// How many rows in the source CSV were skipped (duplicates, unmapped).
  skippedCount     Int      @default(0)
  /// Free-form notes from the importer ("3 rows had unmapped 'FXEXCHG' actions").
  notes            String?
  importedAt       DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, importedAt(sort: Desc)])
  @@map("import_batch")
}

// ─── Market data cache (Phase 3) ──────────────────────────────────────
// Lazy-populated by lib/marketdata. TTLs enforced in code, not the DB.

model Quote {
  ticker    String   @id
  price     Decimal  @db.Decimal(18, 4)
  change    Decimal  @db.Decimal(18, 4)
  changePct Decimal  @db.Decimal(10, 4)
  prevClose Decimal  @db.Decimal(18, 4)
  open      Decimal? @db.Decimal(18, 4)
  high      Decimal? @db.Decimal(18, 4)
  low       Decimal? @db.Decimal(18, 4)
  asOf      DateTime
  source    String   @default("finnhub")
  fetchedAt DateTime @default(now())

  @@map("quote")
}

model NewsItem {
  id           String        @id
  ticker       String
  headline     String
  summary      String?
  url          String
  source       String
  publishedAt  DateTime
  // AI-classified materiality. Null = not yet classified.
  aiSeverity   NewsSeverity?
  classifiedAt DateTime?
  fetchedAt    DateTime      @default(now())

  @@index([ticker, publishedAt])
  @@index([ticker, aiSeverity])
  @@map("news_item")
}

model Fundamentals {
  ticker        String   @id
  companyName   String?
  industry      String?
  exchange      String?
  marketCap     Decimal? @db.Decimal(20, 2)
  peTtm         Decimal? @db.Decimal(10, 2)
  forwardPe     Decimal? @db.Decimal(10, 2)
  dividendYield Decimal? @db.Decimal(8, 6)
  beta          Decimal? @db.Decimal(8, 4)
  fiftyTwoHigh  Decimal? @db.Decimal(18, 4)
  fiftyTwoLow   Decimal? @db.Decimal(18, 4)
  logo          String?
  weburl        String?
  fetchedAt     DateTime @default(now())

  @@map("fundamentals")
}

model Candle {
  ticker String
  ts     DateTime
  open   Decimal  @db.Decimal(18, 4)
  high   Decimal  @db.Decimal(18, 4)
  low    Decimal  @db.Decimal(18, 4)
  close  Decimal  @db.Decimal(18, 4)
  volume BigInt

  @@id([ticker, ts])
  @@index([ticker, ts])
  @@map("candle")
}

/// Earnings-call transcript cache. Populated on-demand by lib/marketdata from
/// Alpha Vantage's EARNINGS_CALL_TRANSCRIPT endpoint. Transcripts are immutable
/// once a call has happened, so cached rows are valid forever (no TTL).
model Transcript {
  ticker    String
  quarter   String // fiscal quarter, e.g. "2024Q1"
  title     String?
  /// Speaker-segmented transcript: [{ speaker, title, content, sentiment }]
  segments  Json
  source    String   @default("alphavantage")
  fetchedAt DateTime @default(now())

  @@id([ticker, quarter])
  @@map("transcript")
}

/// CAD-denominated FX rate cache, keyed by (currency, calendar date UTC).
/// Populated on-demand by lib/marketdata/fx.ts from the Bank of Canada Valet
/// API. Historical rates never change so cached rows are valid forever.
/// `asOf` is the actual BoC observation date used (may be earlier than the
/// requested date on weekends/holidays).
model FxRate {
  currency  String
  date      DateTime @db.Date
  rate      Decimal  @db.Decimal(18, 8)
  asOf      DateTime @db.Date
  source    String   @default("BOC_VALET")
  fetchedAt DateTime @default(now())

  @@id([currency, date])
  @@map("fx_rate")
}

// ─── Alerts ────────────────────────────────────────────────────────────

enum AlertRule {
  PRICE_MOVE
  DRAWDOWN
  CONCENTRATION
  MA_CROSS_50
  MA_CROSS_200
  VOLUME_SPIKE
  NEWS_MATERIAL
  /// Non-reg holding has dropped > thresholdPct below ACB AND there's no
  /// active superficial-loss window AND no open PlannedAction yet. The alert
  /// names the loss size, estimated tax saving, and a replacement candidate.
  TLH_OPPORTUNITY
  /// Any IPS category has been outside drift threshold for ≥ N consecutive
  /// trading days. Alert suggests trim/buy plan respecting account types.
  REBALANCE_DUE
  /// A new filing's summary suggests the user's stated invalidation criteria
  /// for an active thesis may be met. Wired in Session 5.
  THESIS_INVALIDATION_CANDIDATE
}

enum NewsSeverity {
  INFO
  MATERIAL
  CRITICAL
}

enum AlertScope {
  PORTFOLIO
  HOLDING
  TICKER
}

model Alert {
  id        String     @id @default(cuid())
  userId    String
  rule      AlertRule
  scope     AlertScope
  // When scope = TICKER, the specific ticker. Null otherwise.
  ticker    String?
  // Rule-specific parameters as JSON, e.g. { "thresholdPct": 5 }
  params    Json
  enabled   Boolean    @default(true)
  // Notification channels, e.g. ["IN_APP"] or ["IN_APP", "EMAIL"]
  channels  Json       @default("[\"IN_APP\"]")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  events AlertEvent[]

  @@index([userId, enabled])
  @@map("alert")
}

model AlertEvent {
  id      String   @id @default(cuid())
  alertId String
  userId  String
  ticker  String?
  firedAt DateTime @default(now())
  // Human-readable summary, e.g. "AAPL up 5.2% today"
  message String
  // Snapshot of values at firing
  data    Json
  read    Boolean  @default(false)

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, firedAt(sort: Desc)])
  @@index([userId, read])
  @@index([alertId, ticker, firedAt(sort: Desc)])
  @@map("alert_event")
}

enum PlannedActionKind {
  /// User intends to harvest a loss on `ticker`. payload contains
  /// replacement-ETF candidate + estimated tax saving. Window auto-arms
  /// against re-buying the same ticker for 30 days. Fulfilled when a SELL
  /// with reasonCode=TLH_HARVEST on this ticker lands.
  TLH_HARVEST
  /// User intends to rebalance per a suggested plan. payload holds the
  /// per-leg trim/buy quantities. Fulfilled when corresponding trades land.
  REBALANCE
  /// User intends to reconsider a thesis after AI flagged invalidation.
  /// Fulfilled when Thesis.status changes off ACTIVE.
  THESIS_REEVALUATION
}

/// Tracks an action the user has *stated intent* to perform after responding
/// to a coaching alert. The platform never executes for the user — it just
/// remembers the plan so it can (a) keep the relevant alert quiet while the
/// plan is open, (b) auto-fulfill when the matching transaction is recorded,
/// (c) warn at entry time if the user is about to violate the plan (e.g.
/// re-buying a TLH-harvested ticker within the 30-day window).
model PlannedAction {
  id           String            @id @default(cuid())
  userId       String
  kind         PlannedActionKind
  ticker       String?
  /// Kind-specific payload — e.g. for TLH_HARVEST:
  /// `{ replacementTicker, lossAmount, taxSaving, brokerageId }`.
  payload      Json
  /// When this intent was registered (typically when the alert email's
  /// "mark as planned" link was clicked).
  plannedAt    DateTime          @default(now())
  /// When the plan should be considered abandoned if not fulfilled. For
  /// TLH_HARVEST, this is the 30-day window expiry. Null = no auto-expiry.
  expiresAt    DateTime?
  /// Set when a matching transaction lands.
  fulfilledAt  DateTime?
  /// Set when the user explicitly dismisses without acting.
  dismissedAt  DateTime?
  /// Optional reference to the originating alert event for audit.
  sourceAlertEventId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, fulfilledAt, dismissedAt])
  @@index([userId, ticker, kind])
  @@map("planned_action")
}

// ─── Watchlist ─────────────────────────────────────────────────────────

model WatchlistItem {
  id      String   @id @default(cuid())
  userId  String
  ticker  String
  note    String?
  addedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ticker])
  @@index([userId])
  @@map("watchlist_item")
}

// ─── AI chat ───────────────────────────────────────────────────────────

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  scope     String?  // "portfolio" or a ticker symbol
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId, updatedAt])
  @@map("ai_conversation")
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  // "user" | "assistant" | "tool"
  role           String
  // Structured content: { text: string, toolCalls?: [...], toolResults?: [...] }
  // For user messages: { text }. For assistant: { text, toolCalls? }. For tool: { toolCallId, name, result }.
  content        Json
  // Token usage on assistant messages (for cost telemetry).
  // `inputTokens` is the *uncached* portion — the part billed at full input
  // rate. `cachedTokens` and `cacheCreationTokens` are billed at separate
  // rates (10% read / ~1.5× write on Anthropic). Splitting them is required
  // to match the figure shown in the provider's billing console.
  inputTokens         Int?
  cachedTokens        Int?
  cacheCreationTokens Int?
  outputTokens        Int?
  model               String?
  createdAt           DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_message")
}

enum AnalysisKind {
  EOD_DAILY
  WEEKLY
  ON_ALERT
  QUARTERLY_DEEP
  /// Once-a-year roll-up: every active thesis re-validated, IPS drift
  /// review, realized P&L summary, TLH used/missed, year-end housekeeping.
  /// Generated on-demand from the /annual-review page.
  ANNUAL_REVIEW
}

enum FilingType {
  // EDGAR — domestic US issuer
  TEN_K           // 10-K   annual
  TEN_Q           // 10-Q   quarterly
  EIGHT_K         // 8-K    material event
  // EDGAR — Canadian foreign private issuer (MJDS forms). Cross-listed
  // names (SHOP, RY, TD, ENB, BMO, MFC, CNQ, BNS, BCE, CP, NTR, TRP, SU)
  // file these instead of 10-K/Q. Coverage replaces SEDAR+ for these.
  FORTY_F         // 40-F   annual report (Canadian 10-K equivalent)
  SIX_K           // 6-K    quarterly + material change (Canadian 8-K/10-Q equivalent)
  TWENTY_F        // 20-F   annual report for non-MJDS foreign issuers
  F_10            // F-10   prospectus
  F_X             // F-X    consent to service of process
  F_3             // F-3    shelf prospectus
  // SEDAR+ (set on Filing rows from CSE / TMX where applicable)
  ANNUAL_INFO_FORM
  MD_AND_A
  ANNUAL_FINANCIAL_STATEMENTS
  INTERIM_FINANCIAL_STATEMENTS
  MATERIAL_CHANGE_REPORT
  // Misc
  OTHER
}

enum FilingSource {
  EDGAR
  SEDAR_PLUS
  CSE
  TMX
}

/// Per-user browser session cookies for external sources that gate access
/// behind bot-management (SEDAR+ Radware + hCaptcha, etc.). The user
/// solves the captcha in their real browser, copies the cookie header,
/// and pastes it here. Server-side fetches reuse those cookies until
/// they expire.
model ExternalCookieSession {
  id           String   @id @default(cuid())
  userId       String
  /// External source identifier: "SEDAR_PLUS", "CANADIAN_INSIDER", etc.
  source       String
  /// Raw Cookie header value (e.g. "__uzma=...; __uzmb=...; ...").
  cookieHeader String   @db.Text
  /// User-Agent string from the same browser session, so the fingerprint
  /// stays consistent with the cookie batch.
  userAgent    String?
  /// Optional notes (e.g. "captured 2026-05-31 from Chrome").
  notes        String?
  /// Hint at when cookies were captured; not enforced.
  expectedExpiry DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source])
  @@index([userId])
  @@map("external_cookie_session")
}

/// Cached ticker → external-source ID mappings. Populated either by
/// auto-resolvers (EDGAR CIK lookup, TMX symbol probe) or manually by the
/// user pasting a CSE / TMX page URL.
model TickerListing {
  id          String   @id @default(cuid())
  /// Canonical ticker as used in this app — e.g. "AAPL", "SHOP.TO",
  /// "MVMD.CN". Suffix indicates listing exchange.
  ticker      String   @unique
  /// Listing exchange code. NYSE / NASDAQ / TSX / TSXV / CSE / NEO / OTHER.
  exchange    String
  name        String?
  /// SEC EDGAR Central Index Key (10-digit, zero-padded).
  cik         String?
  /// CSE issuer ID (e.g. "000023721") for webapi.thecse.com.
  cseIssuerId String?
  /// CSE URL slug (sector/company-slug) for thecse.com lookups.
  cseSlug     String?
  /// TMX symbol (usually same as ticker minus suffix).
  tmxSymbol   String?
  /// Cision Newswire slug for the issuer's press release page
  /// (newswire.ca/news/<slug>/). Auto-derived from `name` when possible,
  /// overridable via UI when the derived slug doesn't match.
  cisionSlug  String?
  /// SEDAR+ issuer number (numeric, e.g. "12345") extracted from a
  /// pasted issuer profile URL. Required for cookie-authed SEDAR+ pulls.
  sedarIssuerNo String?
  /// Canonical SEDAR+ issuer-profile URL — what the user pasted, kept
  /// for reference / re-resolution.
  sedarProfileUrl String?
  resolvedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ticker_listing")
}

enum ThesisStatus {
  ACTIVE
  TRIMMED
  EXITED
  INVALIDATED
}

/// Investment policy statement. One row per user. Targets and behavioral
/// thresholds are user-supplied — nulls disable the corresponding checks.
model InvestmentPolicy {
  id                  String   @id @default(cuid())
  userId              String   @unique
  /// Target asset allocation as percentages keyed by category, e.g.
  /// { "Equity": 60, "Bonds": 30, "Cash": 10 }. Sum should be ~100.
  targetAllocation    Json     @default("{}")
  /// Target geographic split, e.g. { "Canada": 40, "US": 50, "Intl": 10 }
  targetGeography     Json     @default("{}")
  /// Drift threshold for rebalance alerts (percentage points, e.g. 5 = ±5pp).
  driftThresholdPct   Decimal? @db.Decimal(5, 2)
  /// Behavioral pattern thresholds. Null = check disabled.
  panicSellDrawdownPct Decimal? @db.Decimal(5, 2)
  panicSellWindowDays  Int?
  fomoBuyRunupPct      Decimal? @db.Decimal(5, 2)
  fomoBuyWindowDays    Int?
  overtradingPerMonth  Int?
  /// Per-ticker categorization, e.g. { "VFV.TO": "Equity:US", "VAB.TO": "Bonds:Canada" }
  tickerCategories    Json     @default("{}")
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("investment_policy")
}

/// Per-position thesis. Captures why you own this name, what would
/// invalidate the thesis, and a price target / horizon.
model Thesis {
  id                  String       @id @default(cuid())
  userId              String
  ticker              String
  body                String
  invalidationCriteria String?
  priceTargetCad      Decimal?     @db.Decimal(18, 4)
  horizonMonths       Int?
  status              ThesisStatus @default(ACTIVE)
  /// Markdown body of the most recent AI re-check ("is thesis still intact?")
  lastAiReview        String?
  lastReviewedAt      DateTime?
  /// When the filings-driven invalidation check last ran for this thesis.
  /// Distinct from lastReviewedAt (which is on-demand "re-check thesis").
  lastInvalidationCheckAt    DateTime?
  /// 0–100 confidence that the latest filing meets the invalidation
  /// criteria. ≥ 60 triggers the THESIS_INVALIDATION_CANDIDATE alert.
  lastInvalidationConfidence Int?
  /// Markdown explaining which criterion triggered and the supporting
  /// excerpt from the filing summary. Surfaced on the thesis card.
  lastInvalidationReasoning  String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ticker])
  @@index([userId, status])
  @@map("thesis")
}

/// Daily portfolio NAV snapshot. Written by /api/cron/eod-snapshot. One row
/// per (userId, date). `byKind` and `holdings` are JSON blobs so we don't
/// proliferate join tables for what's effectively a frozen wire format.
model PortfolioSnapshot {
  id             String   @id @default(cuid())
  userId         String
  /// Calendar date (UTC) the snapshot represents. UNIQUE per user.
  date           DateTime @db.Date
  totalCost      Decimal  @db.Decimal(18, 2)
  totalMarketValue Decimal @db.Decimal(18, 2)
  totalRealized  Decimal  @db.Decimal(18, 2)
  totalDividends Decimal  @db.Decimal(18, 2)
  /// { NON_REGISTERED: { quantity, costBasis, marketValue }, ... }
  byKind         Json
  /// Per-ticker { ticker, quantity, costBasis, marketValue }
  holdings       Json
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date(sort: Desc)])
  @@map("portfolio_snapshot")
}

model Filing {
  id           String       @id @default(cuid())
  ticker       String
  type         FilingType
  source       FilingSource
  /// External accession number / document identifier, used for dedup.
  externalId   String
  title        String?
  /// Public link to the filing (HTML viewer).
  url          String
  filedAt      DateTime
  /// Extracted plaintext body, lazily populated by the cron / on-demand fetch.
  body         String?
  fetchedAt    DateTime     @default(now())

  @@unique([source, externalId])
  @@index([ticker, filedAt(sort: Desc)])
  @@index([ticker, type, filedAt(sort: Desc)])
  @@map("filing")
}

model AIAnalysis {
  id           String       @id @default(cuid())
  userId       String
  kind         AnalysisKind
  ticker       String?
  title        String?
  // Markdown body
  body         String
  // Snapshot of the metrics the review was written against
  metrics      Json?
  model               String?
  inputTokens         Int?
  cachedTokens        Int?
  cacheCreationTokens Int?
  outputTokens        Int?
  generatedAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, generatedAt(sort: Desc)])
  @@index([userId, generatedAt(sort: Desc)])
  @@map("ai_analysis")
}
